# Copy to .env - read by docker-compose.yml, which passes it to all three
# services (prisme-db, prisme-worker, prisme-frontend). Local (non-Docker)
# development doesn't use this file - see src/worker/.env.example and
# src/frontend/.env.example instead, since `uv run python __main__.py` and
# `npm run dev` each load their own scoped .env file by convention.

POSTGRES_DATABASE=Prisme
POSTGRES_USER=prisme_db
POSTGRES_PASSWORD=

# pgcrypto passphrase used to decrypt stored LCL credentials, shared by the
# worker and the frontend.
CREDENTIALS_ENCRYPTION_KEY=

# Set to "true" to run the frontend against in-memory demo fixtures instead of
# PostgreSQL/Authentik - useful for a public showcase deploy or trying Prisme
# without a real LCL account. When enabled, the AUTHENTIK_* variables below
# are not read and can be left unset.
DEMO_MODE=false

NEXTAUTH_URL=http://localhost:3000
# Run: openssl rand -base64 32
NEXTAUTH_SECRET=

# Your Authentik issuer URL, e.g. https://auth.example.com/application/o/prisme
AUTHENTIK_ISSUER=
# OIDC client id (Authentik admin -> Applications)
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
# Authentik userinfo endpoint, e.g. https://auth.example.com/application/o/userinfo/
AUTHENTIK_USER_INFO_URL=
